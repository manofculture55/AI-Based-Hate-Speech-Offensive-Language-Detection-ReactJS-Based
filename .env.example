# =============================================================
# Backend configuration
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (macOS/Linux)
#
# Every value below is optional -- the app falls back to the
# defaults shown here. It will print a warning at startup for as
# long as the shipped secret values are still in use.
# =============================================================

# --- Secrets -------------------------------------------------
# CHANGE THESE. The defaults are public: they are in the repo.

# Key clients send as `X-API-KEY` to the public prediction endpoint.
HSD_API_KEY=dev-api-key-change-me

# Key the frontend sends as `X-ADMIN-KEY` for admin endpoints.
# Issued by POST /api/v1/admin/sessions in exchange for the password.
HSD_ADMIN_KEY=dev-admin-key-change-me

# Password typed into the Admin login form. Verified server-side.
HSD_ADMIN_PASSWORD=admin123


# --- API behaviour -------------------------------------------

# Require a valid X-API-KEY on POST /api/v1/predictions.
# Leave 0 while the web UI calls that endpoint directly from the browser.
HSD_REQUIRE_API_KEY=0

# Reject longer inputs with 422.
HSD_MAX_TEXT_LENGTH=500

# Pagination defaults and ceiling for ?per_page=
HSD_DEFAULT_PAGE_SIZE=20
HSD_MAX_PAGE_SIZE=100

# Largest accepted dataset upload, in megabytes.
HSD_MAX_UPLOAD_MB=16

# Serve the pre-v1 URLs (/predict, /history, ...) as deprecated shims.
# Set to 0 once nothing depends on them any more.
HSD_ENABLE_LEGACY_ROUTES=1

# Identical votes needed before a survey text's label is settled.
HSD_SURVEY_CONSENSUS=3


# --- Server --------------------------------------------------

HSD_HOST=127.0.0.1
HSD_PORT=5000

# Never enable debug on a reachable host: it exposes an interactive
# Python console on any traceback.
HSD_DEBUG=0

# Comma-separated browser origins allowed to call the API.
HSD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
