# ===============================
# Python / Backend
# ===============================
venv/
env/
__pycache__/
*.pyc
*.pyo
*.log

# ===============================
# Machine Learning Artifacts
# ===============================
# Trained model weights (force training on first run)
backend/models/**/*.h5
backend/models/**/*.pt
backend/models/**/*.bin

# ===============================
# Data & Databases
# ===============================
backend/data/clean_data.csv
backend/data/app.db

# ===============================
# Reports / Training Outputs
# ===============================
backend/reports/

# ===============================
# Frontend / React
# ===============================
frontend/node_modules/
frontend/build/
frontend/.cache/

# React lock files (fresh CRA every install)
frontend/package-lock.json
frontend/yarn.lock
frontend/pnpm-lock.yaml

# ===============================
# Environment / Secrets
# ===============================
.env
.env.*
*.key
*.secret

# ...but the templates must be committed, or a fresh clone has no
# idea which variables the app expects.
!.env.example
!frontend/.env.example

# ===============================
# Setup state
# ===============================
# Written by install.bat once setup succeeds; run.bat is the entry point
# afterwards. Machine-local, so it must not be committed.
.setup-complete

# ===============================
# IDE / OS / Tooling
# ===============================
.vscode/
.idea/
.DS_Store
Thumbs.db
