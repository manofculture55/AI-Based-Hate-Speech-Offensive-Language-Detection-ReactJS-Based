# Base URL of the backend API.
#
#   copy .env.example .env
#
# Create React App only exposes variables prefixed with REACT_APP_,
# and only reads this file at startup -- restart `npm start` after
# changing it.
#
# Optional: src/api/client.js falls back to this exact value.
REACT_APP_API_BASE_URL=http://127.0.0.1:5000/api/v1
